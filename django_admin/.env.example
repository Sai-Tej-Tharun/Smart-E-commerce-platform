# Copy this file to .env and fill in your real values.
# DB_* should match fastapi_backend/.env exactly — same database.

DJANGO_SECRET_KEY=change_this_to_a_long_random_secret_string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=ecommerce_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# ==========================================
# Notification system — must match fastapi_backend/.env's
# INTERNAL_API_SECRET exactly, and FASTAPI_INTERNAL_URL must point at
# wherever uvicorn is actually running.
# ==========================================
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000
INTERNAL_API_SECRET=insecure-dev-internal-secret-change-mepython manage.py runserver 8001