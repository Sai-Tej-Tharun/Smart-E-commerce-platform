# ==========================================
# Application
# ==========================================
APP_NAME=Smart E-Commerce Platform
APP_VERSION=1.0.0
DEBUG=True

# ==========================================
# Database (MySQL)
# ==========================================
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce_db

# ==========================================
# JWT
# ==========================================
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# Auth0 (Social Login: Google / Facebook)
# Create a free tenant at https://auth0.com, then fill these in.
# ==========================================


AUTH0_DOMAIN=dev-6ypi20q7lq2gd0v2.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
AUTH0_CLIENT_ID=JnB4hOfnQdZOc6FvWInyLmJfCya9LbIV
# ==========================================
# CORS
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================================
# Cart tax rate (0.08 = 8%, 0 = no tax)
# ==========================================
TAX_RATE=0.08

# ==========================================
# Stripe (Checkout & Payments)
# Get test keys from https://dashboard.stripe.com/test/apikeys
# Get STRIPE_WEBHOOK_SECRET by running `stripe listen --forward-to localhost:8000/webhooks/stripe`
# ==========================================
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
FRONTEND_URL=http://localhost:5173
CURRENCY=inr

# ==========================================
# Email Notifications (SMTP — also works with SendGrid/AWS SES SMTP relays)
# For local dev, use a free Mailtrap.io inbox (see Screenshot Guide).
# Leave SMTP_HOST blank to just log emails to the console instead.
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@glowveda.example

# ==========================================
# Internal API secret — shared between fastapi_backend and django_admin
# so Django can trigger a notification when an admin marks an order
# shipped/delivered. Change this to a random string; it must match
# django_admin/.env's INTERNAL_API_SECRET exactly.
# ==========================================
INTERNAL_API_SECRET=insecure-dev-internal-secret-change-me